{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "harmonia-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "harmonia-developer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "harmonia-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:phone",
        "--",
        "--strictPort"
      ],
      "port": 5443,
      "url": "https://localhost:5443"
    }
  ]
}