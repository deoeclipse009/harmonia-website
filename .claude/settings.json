{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jorge/AppData/Local/Programs/Python/Python313/Scripts/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jorge/AppData/Local/Programs/Python/Python313/Scripts/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jorge/AppData/Local/Programs/Python/Python313/Scripts/graphify.EXE hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}