# Copy to .env.local for development. In production set these in Vercel.
# Never commit real values.

# Signs panel sessions. Any long random string.
SESSION_SECRET=
# Password for the built-in "admin" user of the ticketing panel.
ADMIN_PASSWORD=

# Turso database. Leave empty in development to use the local file .data/harmonia.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# E-ticket email through Resend. Leave empty to switch email off.
RESEND_API_KEY=
MAIL_FROM=
# Public address of the site, used for links inside emails.
PUBLIC_URL=
